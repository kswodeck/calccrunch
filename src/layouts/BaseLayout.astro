---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AdUnit from "../components/AdUnit.astro";
import PushNotification from "../components/PushNotification.astro";
import "../styles/global.css";

// Destructure props (no TypeScript interfaces needed)
const {
  title,
  description,
  keywords = "free calculator, online calculator, financial calculator, mortgage calculator, loan calculator, BMI calculator",
  ogImage = "https://calccrunch.com/images/heroes/hero-home.png",
  canonical,
} = Astro.props;

const FONT_CSS =
  "https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&family=Open+Sans:wght@300;400;600&family=Roboto+Mono:wght@400;500&display=swap";

const fullTitle = `${title} | CalcCrunch`;
const canonicalURL =
  canonical || new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/*
      These used to point at logo-icon.png — a 738x738, 550 KB source image
      that every page load pulled down just to draw a 16px tab icon. The
      resized variants below carry the same artwork at ~15 KB and are derived
      from it at build time by scripts/generate-icons.mjs.
    */}
    <link rel="icon" type="image/png" sizes="192x192" href="/images/logos/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/logos/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="alternate" type="application/rss+xml" title="CalcCrunch RSS Feed" href="/rss.xml" />

    <!-- Theme initialization (runs before render to prevent flash) -->
    <script is:inline>
      (function() {
        var theme = localStorage.getItem('theme');
        if (!theme) {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>

    {/*
      Google Fonts. `media="print"` keeps the request off the critical
      rendering path; the onload flip applies it as soon as it arrives. Every
      family has a system fallback in variables.css and the URL carries
      display=swap, so text paints immediately either way.
    */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href={FONT_CSS}
      media="print"
      onload="this.media='all';this.onload=null"
    />
    <noscript><link rel="stylesheet" href={FONT_CSS} /></noscript>

    <!-- Resource Hints -->
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />

    <!-- Theme Color -->
    <meta name="theme-color" content="#2C5F8D" />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="CalcCrunch" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />
    <meta name="google-adsense-account" content="ca-pub-7168350672318573" />

    <!-- Structured Data - Organization -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "CalcCrunch",
        "alternateName": "Calc Crunch",
        "url": "https://calccrunch.com",
        "description": "Free online calculators for financial planning, health tracking, home projects, and more. Calculate anything instantly.",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://calccrunch.com/search?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    </script>
    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-HD4P633GWP"
      is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-HD4P633GWP");
    </script>
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7168350672318573"
      crossorigin="anonymous"
      is:inline></script>
  </head>
  <body>
    <Header />

    <main>
      <slot />
      <!-- Ad Unit (multiplex) -->
      <AdUnit slot="1019949885" format="autorelaxed" />
    </main>

    <Footer />
    <PushNotification />

    {/*
      Collapses the placeholder for any ad slot the network never filled
      (usually an ad blocker), so readers don't see an empty grey box. Lives
      here rather than in AdUnit.astro because it already sweeps every
      .adsbygoogle on the page — inlining it per unit shipped up to four
      identical copies of this script in a single document.
    */}
    <script is:inline>
      setTimeout(function () {
        document.querySelectorAll(".adsbygoogle").forEach(function (el) {
          if (el.offsetHeight === 0 || el.childElementCount === 0) {
            var unit = el.closest(".ad-unit");
            if (unit) unit.style.display = "none";
          }
        });
      }, 500);
    </script>

    <script>
      import "../scripts/search";
    </script>
    <script>
      function initThemeToggle() {
        const toggles = document.querySelectorAll('.theme-toggle');
        toggles.forEach(toggle => {
          toggle.addEventListener('click', () => {
            const current = document.documentElement.getAttribute('data-theme');
            const next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('theme', next);
          });
        });
      }

      initThemeToggle();
      document.addEventListener('astro:after-swap', initThemeToggle);
    </script>
    {/*
      Netlify Identity is only needed to complete an emailed invite/recovery
      link, which lands on the site root with the token in the URL fragment.
      Loading the ~100 KB widget on all 180+ pages to catch that rare case is
      not worth it, so it is injected on demand. (/admin/ loads the widget
      itself — see public/admin/index.html.) Kept terse: this inline script
      ships in every page's HTML.
    */}
    <script is:inline>
      if (/[#&](invite|recovery|confirmation|email_change|access)_token=/.test(location.hash)) {
        var ni = document.createElement("script");
        ni.src = "https://identity.netlify.com/v1/netlify-identity-widget.js";
        ni.async = true;
        ni.onload = function () {
          window.netlifyIdentity && netlifyIdentity.on("init", function (user) {
            if (!user) netlifyIdentity.on("login", function () { location.href = "/admin/"; });
          });
        };
        document.head.appendChild(ni);
      }
    </script>
  </body>
</html>
